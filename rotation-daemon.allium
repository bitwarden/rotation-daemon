-- allium: 3
-- rotation-daemon.allium

-- Scope: Credential rotation daemon for Bitwarden
-- Includes:
--   Server connection lifecycle
--   Rotation task lifecycle and retry behaviour
--   Target system integrations: Entra, MSSQL, CustomScript
--   Credential resolution for target system connections
-- Excludes:
--   Bitwarden server internals (external system)
--   Bitwarden Secrets Manager internals (external system)
--   Password generation algorithm internals
--   Deployment and containerisation (Docker, etc.)

config {
    max_retry_attempts: Integer = 5
    retry_base_delay: Duration = 1.second
}

-- External entities managed by Bitwarden

external entity Cipher {
    id: String
    username: String
    password: String
}

-- Value types

value PasswordPolicy {
    min_length: Integer
    max_length: Integer
    include_uppercase: Boolean
    include_lowercase: Boolean
    include_digits: Boolean
    include_symbols: Boolean
}

-- Target systems

entity TargetSystem {
    id: String
    name: String
    kind: Entra | MSSQL | CustomScript
    password_policy: PasswordPolicy
    supports_session_termination: Boolean
    -- Whether the daemon can rotate this system's credentials automatically.
    -- Orthogonal to kind: a system may have no automated integration, or be one
    -- the daemon cannot reach, and so must be rotated by hand. The server uses
    -- this to constrain a rotation configuration's mode (see
    -- rotation-server.allium / CreateRotationConfig and the manual fallback).
    supports_automatic_rotation: Boolean
}

variant Entra : TargetSystem {
    tenant_id: String
}

variant MSSQL : TargetSystem {
    host: String
    port: Integer
    database: String?
}

variant CustomScript : TargetSystem {
    command: String
}

-- Rotation task

entity RotationTask {
    id: String
    target_system: TargetSystem
    cipher: Cipher
    account_identity: String
    terminate_sessions: Boolean
    status: pending | executing | succeeded | failed
    attempt_count: Integer
    failure_reason: String?

    transitions status {
        pending -> executing
        executing -> succeeded
        executing -> failed
        terminal: succeeded, failed
    }

    has_retries: attempt_count < config.max_retry_attempts
}

-- Session termination
-- A rotation task may request that active sessions for the rotated account be
-- terminated. Termination is best-effort and decoupled from the rotation: the
-- rotation task succeeds once the password is rotated. When requested and
-- supported, termination runs as its own task with an independent retry
-- lifecycle so a termination failure never re-runs the rotation.

entity SessionTermination {
    id: String
    rotation_task: RotationTask
    status: queued | terminating | terminated | abandoned
    attempt_count: Integer
    failure_reason: String?

    transitions status {
        queued -> terminating
        terminating -> terminated
        terminating -> abandoned
        terminal: terminated, abandoned
    }

    has_retries: attempt_count < config.max_retry_attempts
}

-- Server connection

entity ServerConnection {
    status: connecting | connected | disconnected

    transitions status {
        connecting -> connected
        connecting -> disconnected
        connected -> disconnected
        disconnected -> connecting
    }
}

-- Authentication
-- The daemon authenticates with the Bitwarden server using a provisioned access
-- token: an OAuth2 client-credentials grant (client_id + client_secret) that the
-- server exchanges for a short-lived bearer access token. The provisioned token
-- also carries a local encryption_key, never transmitted, which the daemon uses to
-- decrypt the organization key the server returns. The daemon needs that key to
-- encrypt password updates into organization vault ciphers, and the server never
-- holds the plaintext key or password (zero-knowledge). This borrows Secrets
-- Manager's token and zero-knowledge key-delivery pattern, but vault-cipher access
-- is a broader authorization than an SM machine account has -- see the open
-- question on the vault key grant.

external entity DaemonCredential {
    client_id: String
    client_secret: String
    encryption_key: String
}

-- The daemon operates with a single provisioned credential.
given {
    credential: DaemonCredential
}

entity DaemonSession {
    id: String
    connection: ServerConnection
    credential: DaemonCredential
    status: authenticating | active | expired | revoked
    access_token: String when status = active
    expires_at: Timestamp when status = active
    organization_key: String when status = active

    transitions status {
        authenticating -> active
        authenticating -> revoked
        active -> expired
        active -> revoked
        expired -> authenticating
        terminal: revoked
    }
}

-- Actors

actor BitwardenServer {
    identified_by: connection.endpoint
}

actor Integration {
    identified_by: task.target_system.id
}

-- Surfaces

surface BitwardenServerSurface {
    facing _: BitwardenServer
    context connection: ServerConnection

    provides:
        ConnectionInterrupted(connection)
            when connection.status = connected
        TaskDispatched()
            when connection.status = connected
}

surface AuthenticationSurface {
    facing _: BitwardenServer
    context session: DaemonSession

    provides:
        AuthenticationSucceeded(session, access_token, expires_at, organization_key)
            when session.status = authenticating
        AuthenticationRejected(session)
            when session.status = authenticating
        SessionRevoked(session)
            when session.status = active

    @guarantee ServerZeroKnowledge
        -- The organization key crosses the server boundary only in encrypted form;
        -- the daemon decrypts it locally with credential.encryption_key, which is
        -- never transmitted. The server never holds the plaintext organization key,
        -- nor any plaintext password the daemon later writes to a cipher.
}

surface IntegrationSurface {
    facing _: Integration
    context task: RotationTask where status = executing

    provides:
        RotationSucceeded(task)
        RotationAttemptFailed(task, reason)
}

surface SessionTerminationSurface {
    facing _: Integration
    context termination: SessionTermination where status = terminating

    provides:
        SessionTerminationSucceeded(termination)
        SessionTerminationAttemptFailed(termination, reason)
}

-- Connection lifecycle

rule DaemonConnects {
    when: connection: ServerConnection.status becomes connecting
    ensures: DaemonSession.created(
        connection: connection,
        credential: credential,
        status: authenticating
    )
    @guidance
        -- Entering the authenticating state represents presenting the provisioned
        -- credential (client_id + client_secret) to the server. The connection is
        -- signalled ready only once authentication succeeds. On reconnection the
        -- daemon reuses the stored credential without re-prompting.
}

rule HandleAuthenticationSucceeded {
    when: AuthenticationSucceeded(session, access_token, expires_at, organization_key)
    requires: session.status = authenticating
    requires: session.connection.status = connecting
    ensures: session.status = active
    ensures: session.access_token = access_token
    ensures: session.expires_at = expires_at
    ensures: session.organization_key = organization_key
    ensures: ConnectionAuthenticated(connection: session.connection)
    @guidance
        -- The server returns a short-lived access token and the organization key in
        -- encrypted form. organization_key here is the daemon-local result of
        -- decrypting that payload with credential.encryption_key (see the
        -- AuthenticationSurface ServerZeroKnowledge guarantee). The connection is
        -- signalled ready only once authentication succeeds (see OpenConnection).
}

rule HandleAuthenticationRejected {
    when: AuthenticationRejected(session)
    requires: session.status = authenticating
    requires: session.connection.status = connecting
    ensures: session.status = revoked
    ensures: ConnectionRefused(connection: session.connection)
}

rule OpenConnection {
    when: ConnectionAuthenticated(connection)
    requires: connection.status = connecting
    ensures: connection.status = connected
}

rule RefuseConnection {
    when: ConnectionRefused(connection)
    requires: connection.status = connecting
    ensures: connection.status = disconnected
}

rule SessionExpires {
    when: session: DaemonSession.expires_at <= now
    requires: session.status = active
    ensures: session.status = expired
    @guidance
        -- The access token has a short lifetime. Once it lapses the daemon must
        -- re-authenticate before it can receive or execute further tasks.
}

rule RefreshSession {
    when: session: DaemonSession.status transitions_to expired
    requires: session.status = expired
    ensures: session.status = authenticating
    @guidance
        -- Re-present the provisioned credential to obtain a fresh access token; the
        -- organization key is re-derived from the new authentication response.
}

rule HandleSessionRevoked {
    when: SessionRevoked(session)
    requires: session.status = active
    ensures: session.status = revoked
    @guidance
        -- The server can revoke a daemon's credential (e.g. an admin revokes the
        -- daemon, see rotation-server.allium / RevokeDaemon). The session becomes
        -- revoked; the server closes the underlying connection separately (see
        -- ServerInterruptsConnection). The daemon cannot reconnect until issued a
        -- new credential.
}

rule ServerInterruptsConnection {
    when: ConnectionInterrupted(connection)
    requires: connection.status = connected
    ensures: connection.status = disconnected
}

rule Reconnect {
    when: connection: ServerConnection.status transitions_to disconnected
    requires: connection.status = disconnected
    ensures: connection.status = connecting
    @guidance
        -- Reconnection attempts use exponential backoff.
}

rule ConnectionEstablished {
    when: _: ServerConnection.status transitions_to connected
    -- Server pushes any pending RotationTasks to the daemon upon each connection.
    -- These arrive as RotationTask.created events, handled by TaskReceived.
}

-- Task execution

rule OnTaskDispatched {
    when: TaskDispatched()
    ensures: RotationTask.created(status: pending, attempt_count: 0)
}

rule TaskReceived {
    when: task: RotationTask.created
    requires: task.status = pending
    ensures: task.status = executing
    ensures: ExecuteRotation(task)
}

rule ExecuteRotation {
    when: ExecuteRotation(task)
    let session = DaemonSession{status: active}
    requires: task.status = executing
    requires: exists session
    -- Steps performed in order:
    -- 1. Resolve connection credentials for task.target_system
    --    Priority: Bitwarden Secrets Manager → environment variables → local config
    -- 2. Generate a new password satisfying task.target_system.password_policy
    -- 3. Update the account identified by task.account_identity in the target system
    -- 4. Encrypt the new password with session.organization_key and write it to
    --    task.cipher.password by submitting it to the server with the server-issued
    --    cipher-write grant (the nonce) for this rotation. The server verifies the
    --    grant before persisting (see rotation-server.allium / CipherWriteIntake and
    --    AcceptCipherUpdate) and only ever stores ciphertext (ServerZeroKnowledge).
    -- Outcome reported by the IntegrationSurface via RotationSucceeded or RotationAttemptFailed.
    @guidance
        -- Steps 2 and 4 use the Bitwarden Rust SDK. Cipher writes require an active
        -- session: without the unlocked organization_key the daemon cannot produce
        -- valid ciphertext, so rotation cannot proceed until authentication succeeds.
        -- The write is additionally gated by the server-issued grant, which is bound
        -- to this cipher and short-lived; a rejected write (expired or mismatched
        -- grant) surfaces as RotationAttemptFailed and retries under a fresh grant.
        -- The rotation always starts from step 1 on each attempt: a fresh password is
        -- generated and both the target system and cipher are updated together so they
        -- remain in sync even after a previous partial failure.
}

rule HandleRotationSucceeded {
    when: RotationSucceeded(task)
    requires: task.status = executing
    ensures: task.status = succeeded
    ensures:
        if task.terminate_sessions and task.target_system.supports_session_termination:
            SessionTermination.created(rotation_task: task, status: queued, attempt_count: 0)
        if task.terminate_sessions and not task.target_system.supports_session_termination:
            SessionTerminationUnsupported(task: task)
    @guidance
        -- Session termination is best-effort and decoupled from rotation success:
        -- the task succeeds once the password is rotated and the cipher is synced.
        -- When termination is requested but the target system does not support it,
        -- a warning is surfaced to the Bitwarden server (via SessionTerminationUnsupported)
        -- rather than failing the task.
}

rule RetryRotation {
    when: RotationAttemptFailed(task, reason)
    requires: task.status = executing and task.has_retries
    ensures: task.attempt_count = task.attempt_count + 1
    ensures: ExecuteRotation(task)
    @guidance
        -- Wait retry_base_delay * 2^(task.attempt_count - 1) before re-emitting
        -- ExecuteRotation so that successive attempts back off exponentially.
}

rule MarkRotationFailed {
    when: RotationAttemptFailed(task, reason)
    requires: task.status = executing and not task.has_retries
    ensures: task.status = failed
    ensures: task.failure_reason = reason
}

-- Session termination execution

rule SessionTerminationReceived {
    when: termination: SessionTermination.created
    requires: termination.status = queued
    ensures: termination.status = terminating
    ensures: ExecuteSessionTermination(termination)
}

rule ExecuteSessionTermination {
    when: ExecuteSessionTermination(termination)
    requires: termination.status = terminating
    -- Terminate active sessions for termination.rotation_task.account_identity on
    -- termination.rotation_task.target_system, using the same connection credentials
    -- resolved for rotation (Secrets Manager → env vars → local config).
    -- Outcome reported by the SessionTerminationSurface via
    -- SessionTerminationSucceeded or SessionTerminationAttemptFailed.
}

rule HandleSessionTerminationSucceeded {
    when: SessionTerminationSucceeded(termination)
    requires: termination.status = terminating
    ensures: termination.status = terminated
}

rule RetrySessionTermination {
    when: SessionTerminationAttemptFailed(termination, reason)
    requires: termination.status = terminating and termination.has_retries
    ensures: termination.attempt_count = termination.attempt_count + 1
    ensures: ExecuteSessionTermination(termination)
    @guidance
        -- Wait retry_base_delay * 2^(termination.attempt_count - 1) before
        -- re-emitting ExecuteSessionTermination. This retry counter is independent
        -- of the rotation's: a termination failure never re-runs the rotation.
}

rule MarkSessionTerminationAbandoned {
    when: SessionTerminationAttemptFailed(termination, reason)
    requires: termination.status = terminating and not termination.has_retries
    ensures: termination.status = abandoned
    ensures: termination.failure_reason = reason
    @guidance
        -- A terminal termination failure does not affect the rotation, which has
        -- already succeeded. The failure is surfaced to the Bitwarden server.
}

-- Invariants

invariant AtMostOneActiveSession {
    for a in DaemonSessions:
        for b in DaemonSessions:
            (a != b and a.status = active) implies b.status != active
}

-- Resolved: the daemon authenticates with a provisioned access token via an OAuth2
-- client-credentials grant, yielding a short-lived, refreshable, revocable session
-- (see DaemonSession, AuthenticationSurface and the auth rules).
-- Resolved (design): the daemon holds the organization key (from authentication) to
-- encrypt cipher writes, but each write is authorised by a server-issued, cipher-bound,
-- single-use grant with a short TTL -- the "nonce" (see rotation-server.allium /
-- CipherWriteGrant, CipherWriteIntake, AcceptCipherUpdate). Writes are therefore tightly
-- scoped to the specific dispatched cipher and window, even though the daemon holds the
-- org key, and the daemon's credential is scoped to the connect/task and PUT-cipher
-- endpoints only.
open question "Read blast radius: holding the organization key lets the daemon decrypt the entire organization vault locally, even though the cipher-binding grant scopes its writes to one cipher. Accept this, or move to per-cipher item keys (delivered per task, grant-bound) to collapse the read scope too? Depends on Bitwarden per-item cipher keys."
open question "Credential re-issuance: once a daemon's credential is revoked the session is terminal. How is a replacement credential provisioned and delivered to the daemon?"
open question "Custom script result format: exit code, stdout parsing, or structured output? Exit code is simplest and most portable."
-- Resolved in rotation-server.allium: TargetSystem instances are registered and
-- managed server-side via TargetSystemRegistration.
-- Resolved in rotation-server.allium: tasks are tracked server-side via TaskDispatch;
-- a dispatch in flight when the connection drops is marked lost and re-dispatched
-- (as a fresh task) on reconnect.
